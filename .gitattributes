# Enforce LF line endings for all text files
* text=auto eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Config files
*.conf text eol=lf
*.cfg text eol=lf

# Patch files
*.patch text eol=lf

# Python
*.py text eol=lf

# Mark binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gz binary
*.tar binary
*.zip binary
*.deb binary
*.rpm binary
*.img binary
*.bz2 binary
*.zst binary