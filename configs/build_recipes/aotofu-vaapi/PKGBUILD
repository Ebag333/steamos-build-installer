# Maintainer: steamos-nvidia-installer
pkgname=steamos-nvidia-aotofu-vaapi
pkgver=0.0.17
pkgrel=1
pkgdesc="AoTofu NVIDIA VA-API driver for SteamOS"
arch=('x86_64')
url="https://github.com/AoTofu/nvidia-vaapi-driver"
license=('MIT')
depends=(
    'libva'
    'libdrm'
    'libglvnd'
    'gst-plugins-bad-libs'
    'gstreamer'
)
makedepends=(
    'meson'
    'ninja'
    'pkgconf'
    'ffnvcodec-headers'
    'linux-api-headers'
    'git'
)
source=()
sha256sums=()

pkgver() {
    cd "$srcdir/nvidia-vaapi-driver" 2>/dev/null || { echo "0.0.17"; return 0; }
    # Try git describe first (works if source is a git clone)
    local ver
    ver="$(git describe --long --tags 2>/dev/null)" || ver=""
    if [[ -n "$ver" ]]; then
        echo "$ver" | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
        return 0
    fi
    # Tarball: extract version from directory name (e.g. nvidia-vaapi-driver-0.0.17)
    local dir_ver
    dir_ver="$(basename "$PWD" | grep -oP '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
    if [[ -n "$dir_ver" ]]; then
        echo "$dir_ver"
        return 0
    fi
    echo "0.0.17"
}

prepare() {
    cd "$srcdir/nvidia-vaapi-driver"
    # Apply any patches
    if [[ -d "$srcdir/patches" ]]; then
        for patch in "$srcdir"/*.patch; do
            [[ -f "$patch" ]] && patch -p1 < "$patch"
        done
    fi
}

build() {
    cd "$srcdir/nvidia-vaapi-driver"
    meson setup build \
        --prefix=/usr \
        --libdir=/usr/lib \
        --buildtype=release \
        --wrap-mode=nofallback
    ninja -C build
}

check() {
    cd "$srcdir/nvidia-vaapi-driver"
    # Run verification commands
    for cmd in "${VERIFY_COMMANDS[@]}"; do
        eval "$cmd" || warning "Verification failed: $cmd"
    done
}

package() {
    cd "$srcdir/nvidia-vaapi-driver"
    DESTDIR="$pkgdir" ninja -C build install
    local license_file="COPYING"
    [[ -f "LICENSE" ]] && license_file="LICENSE"
    install -Dm644 "$license_file" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
